  "draggable responsive dialog drawer": {
    "prefix": "draggable_responsive_dialog_drawer",
    "description": "Description_for_new_snippet",
    "scope": "javascript, typescript",
    "body": [
      "import { Move, X } from \"lucide-react\";",
      "import React, { useCallback, useRef, useState } from \"react\";",
      "import { Button, ButtonStyled, Dialog, DialogContent } from \"~/components\";",
      "import { useSidebar } from \"~/components/ui/sidebar\";",
      "",
      "export default function MainFunction() {",
      "    const { isMobile } = useSidebar()",
      "    const [isDialogOpen, setIsDialogOpen] = useState(false);",
      "    // DRAGGING",
      "    const [position, setPosition] = useState({ x: -200, y: -450 });",
      "    const [isDragging, setIsDragging] = useState(false);",
      "    const dragRef = useRef<HTMLDivElement>(null);",
      "    const startPosRef = useRef<{ x: number; y: number } | null>(null);",
      "    const shadowPosRef = useRef<{ x: number; y: number }>({ x: -350, y: -850 });",
      "",
      "    const handleMouseMove = useCallback((e: MouseEvent) => {",
      "        if (!isDragging || !startPosRef.current) return;",
      "",
      "        const shadowX = e.clientX - (startPosRef.current?.x || 0);",
      "        const shadowY = e.clientY - (startPosRef.current?.y || 0);",
      "",
      "        shadowPosRef.current = { x: shadowX, y: shadowY };",
      "",
      "        if (dragRef.current) {",
      "            dragRef.current.style.transform = `translate(${shadowX}px, ${shadowY}px)`;",
      "        }",
      "    }, [isDragging]);",
      "",
      "    const handleMouseUp = useCallback(() => {",
      "        // Set final position when dragging ends",
      "        setPosition(shadowPosRef.current);",
      "",
      "        // Reset dragging state",
      "        setIsDragging(false);",
      "        startPosRef.current = null;",
      "",
      "        // Remove visual transform",
      "        if (dragRef.current) {",
      "            dragRef.current.style.transform = 'none';",
      "        }",
      "    }, []);",
      "",
      "    useEffect(() => {",
      "        // Only add listeners when dragging",
      "        if (isDragging) {",
      "            document.addEventListener('mousemove', handleMouseMove, { passive: true });",
      "            document.addEventListener('mouseup', handleMouseUp, { passive: true });",
      "        }",
      "",
      "        // Cleanup function",
      "        return () => {",
      "            document.removeEventListener('mousemove', handleMouseMove);",
      "            document.removeEventListener('mouseup', handleMouseUp);",
      "        };",
      "    }, [isDragging, handleMouseMove, handleMouseUp]);",
      "",
      "    const handleRef = useRef<HTMLButtonElement>(null);",
      "    const handleMouseDown = useCallback((e: React.MouseEvent) => {",
      "        // Ensure we're dragging from the handle",
      "        if (e.target !== handleRef.current) return;",
      "",
      "        e.preventDefault();",
      "",
      "        // Capture initial mouse position",
      "        startPosRef.current = {",
      "            x: e.clientX - position.x,",
      "            y: e.clientY - position.y",
      "        };",
      "",
      "        // Initialize shadow position to current position",
      "        shadowPosRef.current = { ...position };",
      "",
      "        setIsDragging(true);",
      "    }, [position.x, position.y]);",
      "",
      "    return (",
      "        <>",
      "            <OpenButton setIsDialogOpen={setIsDialogOpen} />",
      "            <ResponsiveDialogDrawer",
      "                setIsDialogOpen={setIsDialogOpen}",
      "                isDialogOpen={isDialogOpen}",
      "                isMobile={isMobile}",
      "                position={position}",
      "                isDragging={isDragging}",
      "                dragRef={dragRef}",
      "            />",
      "        </>",
      "    )",
      "}",
      "function OpenButton({ setIsDialogOpen }) {",
      "    return (",
      "        <ButtonStyled",
      "            primary={false}",
      "            className=\" mr-auto ml-3 w-[150px] text-xs h-7 \"",
      "            onClick={() => { setIsDialogOpen(true);  }} >",
      "           Open",
      "        </ButtonStyled>",
      "    )",
      "}",
      "function MoveButton({ handleMouseDown, handleRef }) {",
      "    return (",
      "        <Button",
      "            ref={handleRef}",
      "            size=\"icon\"",
      "            variant=\"ghost\"",
      "            type='button'",
      "            onMouseDown={handleMouseDown}",
      "            className=' cursor-move'",
      "        >",
      "            <Move />",
      "        </Button>",
      "    )",
      "}",
      "function ResponsiveDialogDrawer({ isDialogOpen, setIsDialogOpen, isMobile, position,   isDragging,   dragRef, }) {",
      "",
      "    if (isMobile === false) {",
      "        return (",
      "            <Dialog",
      "                open={isDialogOpen}",
      "                onOpenChange={setIsDialogOpen}",
      "                modal={false} >",
      "                <DialogContent",
      "                    onInteractOutside={(e) => { e.preventDefault(); }}",
      "                    ref={dragRef}",
      "                    className={cn(",
      "                        isDragging ? \"pointer-events-none\" : \"\",",
      "                        isMobile === false ?",
      "                            \"absolute z-[100] bg-background border border-border border-dashed text-foreground shadow-md max-h-[90vh] h-auto\" :",
      "                            \"w-full h-full fixed bottom-0 left-0 right-0 z-[100] bg-background border-none  border-dashed\"",
      "                    )}",
      "                    style={{",
      "                        ...(isMobile === false ? {",
      "                            transform: `translate(${position.x}px, ${position.y}px)`,",
      "                            transition: isDragging ? 'none' : 'transform 0.1s ease-out',",
      "                            willChange: 'transform',",
      "                            width: small ? '325px' : '750px'",
      "                        } : {",
      "                            transform: 'none',",
      "                            transition: 'none',",
      "                        })",
      "                    }}",
      "                >",
      "                    <Content />",
      "                </DialogContent>",
      "            </Dialog>",
      "        )",
      "    }",
      "",
      "    return (",
      "        <Drawer open={isDialogOpen} onOpenChange={setIsDialogOpen}>",
      "            <DrawerContent>",
      "                <Content />",
      "                <DrawerFooter className=\"pt-2\">",
      "                    <DrawerClose asChild>",
      "                        <Button variant=\"outline\">Cancel</Button>",
      "                    </DrawerClose>",
      "                </DrawerFooter>",
      "            </DrawerContent>",
      "        </Drawer>",
      "    )",
      "}",
      "function Content({ handleMouseDown, handleRef }) {",
      "    return (",
      "        <div className='grid grid-cols-1 gap-3' >",
      "            <div className=\"flex justify-between items-center  gap-1 p-2\">",
      "                <div>",
      "",
      "                </div>",
      "                <div className='flex items-center gap-1'>",
      "                    <MoveButton  handleRef={handleRef}  handleMouseDown={handleMouseDown}  />",
      "                    <Button",
      "                        size=\"icon\"",
      "                        variant=\"ghost\"",
      "                        type='button'",
      "                        onClick={() => setIsDialogOpen(false)}",
      "                    >",
      "                        <X />",
      "                    </Button>",
      "",
      "                </div>",
      "            </div>",
      "            <div className='grid grid-cols-1 gap-3' >",
      "                <div className=\"p-4 max-h-[75vh] h-auto  overflow-y-auto\">",
      "                 ",
      "                </div>",
      "            </div>",
      "        </div>",
      "    )",
      "}"
    ]
  },
