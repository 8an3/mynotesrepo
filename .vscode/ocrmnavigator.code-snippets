      "              <FormMessage />",
      "            </FormItem>",
      "          )}",
      "        />",
      "        <FormField",
      "          control={form.control}",
      "          name=\"theme\"",
      "          render={({ field }) => (",
      "            <FormItem className=\"space-y-1\">",
      "              <FormLabel>Theme</FormLabel>",
      "              <FormDescription>",
      "                Select the theme for the dashboard.",
